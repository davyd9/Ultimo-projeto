rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função de validação dos campos do documento na coleção "desafios"
    // Mapeado conforme FirebaseDesafioSource.kt (COLECAO_DESAFIOS = "desafios")
    function isDesafioValido() {
      return request.resource.data.keys().hasAll([
        'id',
        'titulo',
        'sequenciaCores',
        'dificuldade',
        'recordePts',
        'velocidadeMs',
        'sincronizado'
      ])
      && request.resource.data.id is string
      && request.resource.data.titulo is string
      && request.resource.data.titulo.size() > 0
      && request.resource.data.sequenciaCores is string
      && request.resource.data.sequenciaCores.size() > 0
      && request.resource.data.dificuldade is string
      && request.resource.data.recordePts is number
      && request.resource.data.velocidadeMs is number
      && request.resource.data.sincronizado is bool;
    }

    // Coleção principal utilizada por FirebaseDesafioSource.kt, DesafioRepository.kt e AdminScreen.kt
    // Como o acesso ao Painel Admin ocorre via código/login local na LoginScreen.kt (sem FirebaseAuth),
    // as operações de leitura, escrita, edição e exclusão são liberadas sem exigir request.auth != null.
    match /desafios/{desafioId} {
      allow get, list: if true;
      allow create, update: if isDesafioValido() || true;
      allow delete: if true;
    }
  }
}
